# Environment template for mobile and server deployments
# Copy this file to .env and add real values before running anything in production.
# Do not commit real secret values to GitHub.

# Core app
NODE_ENV=development
HOST=0.0.0.0
PORT=4173

# AI / voice
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini-realtime-preview

# Map providers
CESIUM_ION_TOKEN=
GOOGLE_MAPS_API_KEY=

# Live data layers
AISSTREAM_API_KEY=
FIRMS_MAP_KEY=
TOMTOM_API_KEY=
OPENSKY_AUTH_MODE=anon
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Additional data sources
LAUNCH_LIBRARY_KEY=
RADIO_BROWSER_URL=https://de1.api.radio-browser.info

# Admin / mobile auth
JWT_SECRET=replace-me-with-secure-key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Firebase / analytics (optional)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
